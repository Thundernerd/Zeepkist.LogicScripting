# Dragging the window's edge up past its minimum, with the storage warning showing, keeps the editor and the error
# panel's header in view in every frame of the drag, and the window comes back at the size and place it was left at,
# after closing it and after test mode.
open-window

# Never compiled, so it shows the storage warning
new-script Horn booster
set-text
power_display(1 & 1)
end
expect-editor-in-view

# From 640 px, far past the minimum, a hundred pixels a frame
drag-window-edge -1000 over 10
screenshot dragged
remember-window-rect

close-window
open-window
expect-window-rect
expect-editor-in-view-each-frame 3
remember-window-rect

place-start
test-mode
back-to-editor
open-window
expect-window-rect
expect-editor-in-view-each-frame 3
expect-no-exceptions
